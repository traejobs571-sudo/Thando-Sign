# Copy this file to assets/.env and add your Gemini API key.
# assets/.env is gitignored — never commit it. This file is the template.
#
# 1. Create a key at https://aistudio.google.com/app/apikey
# 2. Copy this file:  cp assets/.env.example assets/.env
# 3. Replace the placeholder with your real key.
GEMINI_API_KEY=your_gemini_api_key_here
